# ---------------------------------------------------------------
# Supabase
# Both of these are safe to expose to the browser.
# Find them in: Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Anthropic
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ — that would
# ship your key to every browser that loads the app.
# Get one at: https://platform.claude.com -> API keys
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Base URL used to build magic-link redirects.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
