# ---------------------------------------------------------------
# Supabase
# Both of these are safe to expose to the browser — Row Level
# Security is what protects the data, not key secrecy.
# Find them in: Supabase dashboard -> Project Settings -> API keys
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Anthropic
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ — that would
# ship your key to every browser that loads the app.
#
# In production this belongs in Vercel's encrypted environment
# variables, never in the repository or a GitHub secret.
# Get one at: https://platform.claude.com -> API keys
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
